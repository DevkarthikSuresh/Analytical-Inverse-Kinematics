<?xml version="1.0" encoding="utf-8"?>
<robot name="gemini_horizontal">
  <link name="world"/>
  <joint name="joint0" type="fixed"><origin xyz="0 0 0"/><parent link="world"/><child link="base_link"/></joint>
  
  <link name="base_link">
    <visual><origin xyz="0 0 0.1"/><geometry><cylinder radius="0.05" length="0.2"/></geometry></visual>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <parent link="base_link"/><child link="shoulder_link"/>
    <axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>
  <link name="shoulder_link"><visual><geometry><sphere radius="0.05"/></geometry></visual></link>

  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <parent link="shoulder_link"/><child link="upper_arm"/>
    <axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>
  <link name="upper_arm">
    <visual><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.04" length="0.3"/></geometry></visual>
  </link>

  <joint name="joint3" type="revolute">
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <parent link="upper_arm"/><child link="forearm"/>
    <axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>
  <link name="forearm">
    <visual><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.035" length="0.3"/></geometry></visual>
  </link>

  <joint name="joint4" type="revolute">
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <parent link="forearm"/><child link="wrist_1"/>
    <axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>
  <link name="wrist_1"><visual><geometry><box size="0.05 0.05 0.05"/></geometry></visual></link>

  <joint name="joint5" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="wrist_1"/><child link="wrist_2"/>
    <axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>
  <link name="wrist_2"><visual><geometry><box size="0.05 0.05 0.05"/></geometry></visual></link>

  <joint name="joint6" type="revolute">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="wrist_2"/><child link="ee_link"/>
    <axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>
  <link name="ee_link"/>
</robot>
